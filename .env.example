# Copy this file to .env and fill in real values. .env is gitignored - never commit real secrets.

# Redis (Celery broker + result backend). Matches docker-compose.yml's redis service by default.
REDIS_URL=redis://localhost:6379/0

# SMTP - leave all MAIL_* unset to fall back to logging instead of sending real email.
MAIL_SERVER=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=your-mailtrap-username
MAIL_PASSWORD=your-mailtrap-password
MAIL_USE_TLS=true
MAIL_DEFAULT_SENDER=noreply@placement-portal.example
